# =============================================================================
# PRODUCAO. Copie para `.env` (cp .env.production.example .env) e troque tudo
# que comeca com "troque-". A API recusa subir em producao se qualquer segredo
# ainda tiver o valor de exemplo.
#
# Gere valores proprios:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Pre-requisito: TLS na frente do nginx (Caddy, Traefik ou balanceador).
# COOKIE_SECURE=true sem HTTPS faz o navegador descartar os cookies de sessao.
# =============================================================================
APP_NAME=RAG Regulatorio Farmaceutico
APP_ENV=production
LOG_LEVEL=INFO

# ---------- Segredos (obrigatorio trocar) ----------
POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-administrativa-forte

# ---------- Rede e sessao ----------
COOKIE_SECURE=true
# Dominios reais. Em producao "*" e recusado.
ALLOWED_HOSTS=rag.exemplo.com.br
ALLOWED_ORIGINS=https://rag.exemplo.com.br
# Rede do proxy/balanceador que fala com o nginx. Fora dela X-Forwarded-For
# e ignorado.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
# Swagger e ReDoc ficam fechados em producao.
ENABLE_API_DOCS=false

# ---------- Ollama (GTX 1650, 4 GB) ----------
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KV_CACHE_TYPE=q8_0
# -1 = modelos sempre residentes na VRAM (maquina dedicada). Elimina a
# partida a frio de ~1 min depois de um periodo sem perguntas.
OLLAMA_KEEP_ALIVE=-1
# Carrega os modelos logo apos a subida, em segundo plano.
OLLAMA_WARMUP=true

COLLECTION_NAME=assuntos_regulatorios_embeddinggemma_v1
